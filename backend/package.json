{
  "name": "@margin-pulse/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "backup": "node backup.js",
    "restore": "node restore.js",
    "test:smoke": "NODE_ENV=test DATABASE_PATH=tests/smoke.sqlite node tests/smoke-test.js",
