# Frontend
# Local Vite / preview: leave as /api/v1 so the Vite proxy (same origin) reaches localhost:4000.
# Absolute remote API example: https://margin-pulse-api.up.railway.app/api/v1
# Pointing a local UI at a remote API requires that API to allow your Vite origin
# (localhost / 127.0.0.1 are allowed by default for this demo; see ALLOW_LOCAL_ORIGINS).
VITE_API_BASE_URL=/api/v1

# Backend
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBERED=30d
GEMINI_API_KEY=
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080
# Vite :5173/:4173 loopback origins are always allowed by the API.
# Also allow other http(s)://localhost and 127.0.0.1 origins for local/demo (default on; set 0 to disable).
ALLOW_LOCAL_ORIGINS=1
# Use :memory: or DATABASE_EPHEMERAL=1 for disposable demo DBs
DATABASE_PATH=
DATABASE_EPHEMERAL=
# Demo-only escape hatch when JWT_SECRET is unset in production (do not use for real data)
ALLOW_INSECURE_DEMO_JWT=

# Encrypted backup operations
BACKUP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
BACKUP_DIRECTORY=
BACKUP_RETENTION_DAYS=30
